package jewelcase:plugin@0.1.0;

/// The plugin contract (design/plugins.md §7). Every import checks its permission in the host.
/// Imports stay linked even when their permission was declined, so a plugin with an optional
/// permission still loads; the call answers an error instead, and `granted` lets a plugin adapt
/// up front.

interface host {
  /// What a plugin can be granted that it reaches through these imports
  /// (requirements/plugins.md §4.1). The hooks that run it are granted too, but are not listed:
  /// a hook's grant is whether its event arrives.
  enum permission {
    library-read,
    /// Creating files that do not exist yet.
    library-add,
    /// Replacing, renaming, and deleting files that do.
    library-change,
    network,
    listening-activity,
    /// The searches of users who turned on sharing them with the plugin.
    search-activity,
    /// Its rate limits that say `"per": "host"` are kept to by every plugin's requests to that
    /// host. Without it, they count only its own requests.
    host-rate-limits,
  }

  /// Why an import did not do what it was asked.
  variant error {
    /// The permission it needs was not granted for this run.
    not-granted,
    /// Not done, as the message says, and asking again the same way never will be: such as a
    /// path that leaves the library, or a value over its limit.
    refused(string),
    /// Tried, and it did not work, as the message says: such as a file that does not exist, or
    /// a library that could not be read. Asking again later may work.
    failed(string),
    /// `http.send` only: not sent, because its destination cannot be asked again for this many
    /// milliseconds. Ask again after that long.
    rate-limited(u64),
    /// `http.send` only: sent, but no reply came in time.
    timed-out,
  }

  /// What this run may use.
  granted: func() -> list<permission>;
  /// A progress line, shown with the run's result.
  log: func(message: string);
}

/// The one library this run is for. There is no library parameter: the host binds it. Every
/// function needs library-read. A page, or a list asked for by ID, holds at most 500; an album's
/// tracks and an artist's albums come whole.
interface library {
  use host.{error};

  record track {
    id: u64,
    title: string,
    /// Ordered; the first is primary.
    artists: list<string>,
    album-id: u64,
    album: option<string>,
    disc-number: u32,
    track-number: option<u32>,
    /// `YYYY`, `YYYY-MM`, or `YYYY-MM-DD`, as precise as the tags.
    release-date: option<string>,
    isrc: option<string>,
    duration-ms: u64,
    has-lyrics: bool,
    /// Where its file is: one of the library's roots (`files.roots`), and a path within it.
    root: u64,
    path: string,
  }

  record album {
    id: u64,
    /// None for the album of untagged files.
    title: option<string>,
    artists: list<string>,
    release-date: option<string>,
    /// Whether it has artwork, embedded or a `cover.*` beside its tracks or above them
    /// (requirements/scanning.md §3.1).
    has-artwork: bool,
  }

  record artist {
    id: u64,
    /// None for the artist of untagged files.
    name: option<string>,
    /// Whether it has an image, from an `artist.*` (requirements/scanning.md §3.2).
    has-image: bool,
    /// Whether it has a biography, from an `artist.txt` (requirements/scanning.md §3.3).
    has-biography: bool,
  }

  /// Tracks in ID order after `after`, or from the first; empty past the end.
  tracks: func(after: option<u64>, limit: u32) -> result<list<track>, error>;
  /// These tracks, in the order asked for, leaving out any not in this library.
  get-tracks: func(ids: list<u64>) -> result<list<track>, error>;
  /// Albums in ID order after `after`, or from the first; empty past the end.
  albums: func(after: option<u64>, limit: u32) -> result<list<album>, error>;
  /// Artists in ID order after `after`, or from the first; empty past the end.
  artists: func(after: option<u64>, limit: u32) -> result<list<artist>, error>;
  /// These albums, in the order asked for, leaving out any not in this library.
  get-albums: func(ids: list<u64>) -> result<list<album>, error>;
  /// These artists, in the order asked for, leaving out any not in this library.
  get-artists: func(ids: list<u64>) -> result<list<artist>, error>;
  /// The album's tracks, by disc and number; empty for an album not in this library. Where they
  /// are is where its `cover.*` belongs.
  album-tracks: func(album-id: u64) -> result<list<track>, error>;
  /// The albums the artist is credited on as an album artist, oldest first, leaving out those
  /// they only appear on (requirements/artists.md §2); empty for an artist not in this library.
  artist-albums: func(artist-id: u64) -> result<list<album>, error>;
}

/// The library's own folders (requirements/plugins.md §3). A path is relative to one of its
/// roots, with `/` between names, and never leaves that root. Whatever a plugin writes, the
/// scanner reads in, exactly as if a person had put it there.
interface files {
  use host.{error};

  record entry {
    name: string,
    directory: bool,
    size: u64,
    modified-ms: u64,
  }

  enum write-mode {
    /// Needs library-add. Fails if the file exists.
    create,
    /// Needs library-change. Fails unless the file exists.
    replace,
  }

  /// The library's roots. Needs library-read, library-add, or library-change.
  roots: func() -> result<list<u64>, error>;
  /// Needs library-read. What a folder holds, by name, 500 at a time: those whose names sort
  /// after `after`, or from the first; empty past the end. `""` is the root itself. Names sort
  /// by their UTF-8 bytes, so a folder changing between pages moves no other entry: each one
  /// there throughout comes once.
  entries: func(root: u64, folder: string, after: option<string>) -> result<list<entry>, error>;
  /// Needs library-read. Up to `length` bytes from `offset`; fewer at the end of the file.
  read: func(root: u64, path: string, offset: u64, length: u32) -> result<list<u8>, error>;
  /// Writes a whole file, making the folders it is in. A replace appears whole or not at all; a
  /// create may be left cut short if the server stops while it writes.
  write: func(root: u64, path: string, contents: list<u8>, mode: write-mode) -> result<_, error>;
  /// Needs library-change. Moves a file or folder to `to`, a path that does not exist yet.
  rename: func(root: u64, path: string, to: string) -> result<_, error>;
  /// Needs library-change. Removes a file, or a folder that is empty.
  delete: func(root: u64, path: string) -> result<_, error>;
}

/// Needs network, and only reaches the destinations the manifest declared, redirects included.
interface http {
  use host.{error};

  enum method { get, head, post, put, patch, delete }

  record request {
    method: method,
    url: string,
    /// `host` and the headers that frame a connection are the host's to set.
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  /// Refused when not sent, as the message says: not an http(s) URL, a destination the manifest
  /// does not name, a header the host sets, or a body over 16 MB. Rate-limited when its
  /// destination asked to be left alone, or every plugin's requests to it have used their pace
  /// for now. Timed out when sent but no reply came within 15 s. Failed when sent but with no
  /// reply to give, as the message says: the connection failed, a redirect led somewhere not
  /// approved or too many times, or the reply was over 16 MB.
  send: func(request: request) -> result<response, error>;
}

/// The plugin's own storage for this library, kept between runs, so nothing learned is
/// fetched twice (requirements/plugins.md §2.1). Needs no permission. It goes when the plugin
/// is uninstalled. A key is 1 to 512 bytes, and a value at most 1 MB. `check-settings` for the
/// server-wide settings or for a user runs outside any library, so it has no state: every call
/// is refused.
interface state {
  use host.{error};

  get: func(key: string) -> result<option<list<u8>>, error>;
  set: func(key: string, value: list<u8>) -> result<_, error>;
  delete: func(key: string) -> result<_, error>;
}

/// What an admin set for the plugin, as its manifest declares (requirements/plugins.md §6):
/// the library's own value, else the server-wide one, else the default. Needs no permission.
interface settings {
  variant value {
    text(string),
    number(f64),
    flag(bool),
  }

  get: func(name: string) -> option<value>;
}

/// Why the plugin is running. A hook's event arrives only if the admin approved that hook.
interface events {
  use library.{track};

  /// Tracks, albums, or artists added, changed, or removed since the last one, in batches.
  /// `changed` holds IDs to read with `library.get-tracks`, `get-albums`, or `get-artists`;
  /// `removed` holds IDs no longer in the library.
  record changes {
    changed: list<u64>,
    removed: list<u64>,
  }

  /// What the scans that finished since the last one found, added together.
  record scan-finished {
    files-seen: u32,
    added: u32,
    updated: u32,
    moved: u32,
    missing: u32,
    problems: u32,
  }

  /// How a play ended.
  enum play-end {
    /// It played to its end.
    finished,
    /// The listener moved on before the end.
    skipped,
    /// Playback stopped, such as by closing the app.
    stopped,
  }

  /// A play that has ended (requirements/analytics.md §1). A play is any track that started;
  /// whether it counts as a listen, such as a scrobble, is the plugin's to judge from these.
  record play {
    track: track,
    /// When it started, in milliseconds since the Unix epoch.
    started-at-ms: u64,
    /// The audio actually heard. Pausing adds nothing; replaying part of it adds that again.
    listen-time-ms: u64,
    end: play-end,
  }

  /// A play that has just started, for "now playing". Only the latest start of each user is
  /// delivered, and only while it is still playing and under a minute old: one that could not
  /// be delivered in time is dropped rather than delivered late (design/hooks.md §1.1).
  record playing {
    track: track,
    /// When it started, in milliseconds since the Unix epoch, as the device reported it.
    started-at-ms: u64,
  }

  /// A kind of result a search returns.
  enum result-kind { track, album, artist }

  /// The result a user acted on.
  record selected {
    kind: result-kind,
    id: u64,
  }

  /// How many of the user's own tracks, albums, and artists a search matched. All zero is a
  /// search for something they do not own.
  record found {
    tracks: u32,
    albums: u32,
    artists: u32,
  }

  /// A search the user settled on: acted on a result, submitted, or left after it stood a
  /// moment (requirements/search.md §6).
  record search {
    /// What `searches-forgotten` names it by.
    id: u64,
    /// Who searched, as `searches-forgotten` names them.
    user: u64,
    query: string,
    found: found,
    selected: option<selected>,
    /// When it was searched, in milliseconds since the Unix epoch.
    searched-at-ms: u64,
  }

  /// Searches a user asked the plugin to forget.
  record forgotten {
    /// The user, as `search.user` names them.
    user: u64,
    /// The searches to forget, by `search.id`. None means they stopped sharing: forget every
    /// search of theirs from this library.
    searches: option<list<u64>>,
  }

  variant event {
    /// An admin pressed Run now: do the plugin's whole job for this library.
    run,
    /// Tracks added, changed, or removed.
    tracks-changed(changes),
    scan-finished(scan-finished),
    /// The schedule came round.
    scheduled,
    /// An admin is saving settings, which `settings.get` answers with during this event. An
    /// error is shown to them and nothing is saved, so a wrong key is caught as it is entered
    /// (requirements/plugins.md §6).
    /// A user connecting the plugin is checked the same way, with their personal settings.
    /// Checked server-wide or for a user, it runs outside any library, with no `state`.
    check-settings,
    /// Plays one user who connected the plugin has finished in this library, oldest first.
    /// `settings.get` answers with that user's personal settings, as well as the shared ones.
    played(list<play>),
    /// One user who connected the plugin has started playing something in this library.
    /// `settings.get` answers with that user's personal settings, as for `played`.
    playing(playing),
    /// Searches one user who shares them with the plugin settled on in this library, oldest
    /// first. `settings.get` answers with that user's personal settings, as for `played`.
    searched(list<search>),
    /// A user asked for searches they shared to be forgotten: forget them. It comes whether or
    /// not they can still use this library or their account, so `settings.get` answers with the
    /// shared settings only. What was already sent on is not the host's to recall
    /// (requirements/users.md §7).
    searches-forgotten(forgotten),
    /// Albums added, changed, or removed. An album changes when anything it shows does: its
    /// title, artists, artwork, or the tracks on it.
    albums-changed(changes),
    /// Artists added, changed, or removed.
    artists-changed(changes),
  }
}

world plugin {
  import host;
  import library;
  import files;
  import http;
  import state;
  import settings;
  import events;
  use events.{event};

  /// Handles one event for the library this run is for, and returns a one-line summary.
  export handle: func(event: event) -> result<string, string>;
}
